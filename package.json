{
  "name": "whale-editor",
  "version": "0.1.0",
  "description": "Whale Editor document editing workspace with DeepSeek V4 integration",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc && cp -R prompts dist/",
    "dev": "tsx watch src/api/server.ts",
    "start": "node dist/src/api/server.js",
    "dev:office": "tsx watch src/api/server.ts --office",
    "start:office": "node dist/src/api/server.js --office",
    "dev:office-https": "tsx watch src/api/server.ts --office --https",
    "start:office-https": "node dist/src/api/server.js --office --https",
    "generate-certs": "tsx scripts/generate-certs.ts",
    "test": "node --test dist/tests/**/*.test.js",
    "test:ts": "tsx --test tests/**/*.test.ts",
    "lint": "eslint src tests --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "fast-xml-parser": "^4.3.2",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "multer": "^1.4.5-lts.1",
    "stripe": "^22.1.0",
    "unpdf": "^1.6.2",
    "uuid": "^9.0.0",
    "winston": "^3.11.0",
    "word-extractor": "^1.0.4",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.0",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.13.2",
    "@typescript-eslint/parser": "^6.13.2",
    "@vitest/coverage-v8": "^1.1.0",
    "eslint": "^8.55.0",
    "playwright": "^1.59.1",
    "tsx": "^4.6.2",
    "typescript": "^5.3.2",
    "vitest": "^1.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "office",
    "docx",
    "pptx",
    "agent",
    "llm",
    "deepseek"
  ],
  "license": "MIT"
}
